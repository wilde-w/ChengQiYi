# 观心 — 环境变量
#
# 重要：没有任何密钥是必需的。空 .env 必须能启动整个系统。
# 三个子系统（LLM / Embedding / 抖音数据源）各自独立解析：
#   密钥为空 → 自动降级为 mock（见 backend/app/config.py）
# 最常见的开发配置是「真 DeepSeek + mock 抖音 + API embedding」，这是完全可用的。

# ---------- 应用 ----------
APP_ENV=dev
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
RUN_MAX_CONCURRENCY=2
SSE_HEARTBEAT_SECONDS=15
LOG_LEVEL=INFO
LOG_JSON=false

# ---------- mock 降级 ----------
# auto   = 密钥为空则 mock（默认）
# always = 全部强制 mock
# never  = 全用真实 provider，缺密钥则启动即失败（绝不静默降级）
MOCK_MODE=auto
MOCK_LLM_LATENCY_MS=900
MOCK_DOUYIN_LATENCY_MS=400
MOCK_DOUYIN_PAGE_SIZE=20
MOCK_DOUYIN_FAIL_RATE=0
# mock 模式下每步最小间隔，让进度条有节奏感而不是四次跳变
MOCK_MIN_STEP_DELAY_MS=120

# ---------- LLM（DeepSeek，OpenAI 兼容） ----------
# auto | deepseek | mock
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：deepseek-chat / deepseek-reasoner / deepseek-v4-flash / deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# ---------- Embedding（OpenAI 兼容，默认 SiliconFlow bge-m3） ----------
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# bge-m3 = 1024。改动此值必须同步重建 Qdrant collection（ingest-kb --reset）
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ---------- 抖音数据源 ----------
# auto | mcp | mock
DOUYIN_PROVIDER=auto
DOUYIN_MCP_TRANSPORT=stdio
DOUYIN_MCP_COMMAND=npx
DOUYIN_MCP_ARGS=[]
DOUYIN_MCP_URL=
# 三家 MCP 工具名不一，用映射表适配
DOUYIN_MCP_TOOLS={"video":"get_video_detail","comments":"get_video_comments","asr":null}
DOUYIN_MCP_FIELD_MAP={}
DOUYIN_REQUEST_TIMEOUT=20

# ---------- 古典文学 MCP（另一个仓：ClassicalNovelProject） ----------
# 只做「查阅原文」，不进分析流水线。
# 下面几个默认值写在 config.py 里、指向本机实测可用的路径，通常不必设；
# 换机器时按需覆盖。关掉这个入口就把 ENABLED 设为 false。
NOVEL_MCP_ENABLED=true
NOVEL_MCP_TRANSPORT=stdio
# 对方的解释器（它的依赖装在那个环境里，通常不是本仓的 .venv）
# NOVEL_MCP_COMMAND=D:/Program Files/miniconda3/envs/pythonartproject/python.exe
NOVEL_MCP_ARGS=["-m","app.mcp.server"]
# 对方仓库根目录。DB_URL 是相对路径，cwd 错了会打开一个空库且不报错。
# NOVEL_MCP_CWD=../ClassicalNovelProject
NOVEL_MCP_URL=
NOVEL_MCP_DB_URL=sqlite+aiosqlite:///./data/novel.db
# 每次调用要起一个子进程，实测约 1.7s
NOVEL_MCP_TIMEOUT=30

# ---------- 基础设施 ----------
POSTGRES_DSN=postgresql+asyncpg://guanxin:guanxin@127.0.0.1:55432/guanxin
REDIS_URL=redis://127.0.0.1:56379/0
QDRANT_URL=http://127.0.0.1:56333
QDRANT_COLLECTION=guanxin_kb_v1
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=guanxin12345

# ---------- 流水线参数 ----------
CLUSTER_MIN_SIZE_AUTO=true
CLUSTER_MIN_SAMPLES=2
CLUSTER_MAX_DEFAULT=5
# 按库配额：心理学,文学,唐诗
RETRIEVAL_QUOTA_QUICK=3,2,1
RETRIEVAL_QUOTA_STANDARD=6,4,3
RETRIEVAL_QUOTA_DEEP=9,6,5
# 引用覆盖率低于此值时重生成一次
CITATION_MIN_COVERAGE=0.6
